# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------------------------------------------
# Supabase Dashboard → Project Settings → Database → Connection string.
# Use the "Transaction" pooler URL (host ...pooler.supabase.com, port 6543) for
# serverless/Vercel. Put your DB password in place of [PASSWORD].
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# Staff email notifications (SMTP — configured for SMTP2GO)
# -----------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in the values. The app sends one email
# addressed to every address in STAFF_EMAILS each time a booking is created,
# edited, or cancelled.
#
# Until SMTP_USER / SMTP_PASS / MAIL_FROM / STAFF_EMAILS are all set, the app
# just logs the message it WOULD send to the server console (nothing is emailed).

# SMTP2GO credentials — dashboard → Sending → SMTP Users → Add SMTP User.
SMTP_USER=your-smtp2go-username
SMTP_PASS=your-smtp2go-password

# SMTP2GO server settings. Use the host shown in your SMTP2GO dashboard —
# it is region-specific (e.g. mail-eu.smtp2go.com for EU, mail.smtp2go.com for US).
SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525

# The "From" address. Verify it (or its domain) in SMTP2GO → Sending → Verified
# Senders. A verified single sender works without DNS; a verified domain gives
# the best deliverability.
MAIL_FROM=Room Booking <bookings@zenexfoundation.org.za>

# Comma-separated list of staff addresses to notify.
STAFF_EMAILS=alice@zenexfoundation.org.za, bob@zenexfoundation.org.za

# Timezone used to format times in the email (defaults to Africa/Johannesburg).
BOOKING_TIMEZONE=Africa/Johannesburg

# -----------------------------------------------------------------------------
# Admins (room management)
# -----------------------------------------------------------------------------
# Comma-separated emails allowed to add/edit/remove rooms via the "Manage rooms"
# tab. Everyone else only sees Calendar + All bookings.
ADMIN_EMAILS=admin@zenexfoundation.org.za
